# Register a public client application in Microsoft Entra ID before enabling
# Microsoft personal mailbox OAuth. Add this loopback redirect URI exactly:
# http://127.0.0.1:3000/api/v1/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=

# "consumers" supports personal Microsoft accounts. Use a tenant only after
# implementing and validating the required enterprise consent configuration.
MICROSOFT_TENANT=consumers
